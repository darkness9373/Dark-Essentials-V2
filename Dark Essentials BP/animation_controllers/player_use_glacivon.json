{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.glacivon1": {
            "initial_state": "default",
            "states": {
                "default":{
                    "transitions": [
                        {"warrior_use1": "(query.get_equipped_item_name == 'glacivon') && (query.is_using_item) && (query.is_sneaking)"}
                    ]
                },
                "warrior_use1": {
                    "transitions": [
                        {"warrior_use11": "(query.get_equipped_item_name == 'glacivon') && query.scoreboard('glacivon1') <= 2 && query.scoreboard('glacivon1') >= 1"}
                    ],
                    "animations":[
                        "glacivon_dash1"
                    ]
                },
                "warrior_use11": {
                    "transitions": [
                        {"default": "(query.get_equipped_item_name == 'glacivon')"}
                    ],
                    "on_entry":[
                        "/scoreboard players set @s glacivon1 0"
                    ]
                }
            }
        },

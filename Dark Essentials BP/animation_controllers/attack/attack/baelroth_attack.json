{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.baelroth_attack": {
      "states": {
        "default": {
          "on_entry": [
            "/tag @s remove no_delay"
          ],
          "on_exit": [
            "/tag @s add no_delay"
          ],
          "transitions": [
            {
              "default2": "variable.attack_time"
            }
          ]
        },
        "default2": {
          "on_exit": [
            "/scoreboard players set @s attack_delay 0"
          ],
          "transitions": [
            {
              "ns1": "variable.attack_time && !query.is_sneaking && q.get_equipped_item_name == 'baelroth'"
            }
          ]
        },
        "ns1": {
          "on_entry": [
            "/summon custom:baelroth_slash_1 ~~~ facing ^^^1000",
             "/summon custom:baelroth_slash_shadow1 ~~~ facing ^^^1000",
            "/particle new:baelroth_slash",
            "/playsound items.baelroth_slash1 @a[r=30] ~~~ 0.3 1",
            "/tag @s add br1",
            "/execute at @e[family=!damage,family=!can_ride,type=!custom:vanish,tag=!br1,c=5,r=5] run particle new:baelroth_impact",
            "/damage @e[type=!custom:baelroth_slash_1,r=5,type=!custom:vanish,tag=!br1] 5",
            "/tag @s remove br1"
          ],
          "on_exit": [
            "/scoreboard players set @s attack_delay 0"
          ],
          "transitions": [
            {
              "ns2": "variable.attack_time && query.scoreboard('attack_delay') >= 8 && !query.is_sneaking && q.get_equipped_item_name == 'baelroth'"
            }
          ]
        },
        "ns2": {
          "on_entry": [
            "/summon custom:baelroth_slash_2 ~~~ facing ^^^1000",
             "/summon custom:baelroth_slash_shadow2 ~~~ facing ^^^1000",
            "/particle new:baelroth_slash",
            "/playsound items.baelroth_slash2 @a[r=30] ~~~ 0.3 1",
            "/tag @s add br2",
            "/execute at @e[family=!damage,family=!can_ride,type=!custom:vanish,tag=!br2,c=5,r=5] run particle new:baelroth_impact",
            "/damage @e[type=!custom:baelroth_slash_2,r=5,type=!custom:vanish,tag=!br2] 5",
            "/tag @s remove br2"
          ],
          "on_exit": [
            "/scoreboard players set @s attack_delay 0"
          ],
          "transitions": [
            {
              "ns3": "variable.attack_time && query.scoreboard('attack_delay') >= 8 && !query.is_sneaking && q.get_equipped_item_name == 'baelroth'"
            }
          ]
        },
        "ns3": {
          "on_entry": [
             "/summon custom:baelroth_thrust ~~~ facing ^^^1000",
             "/summon custom:baelroth_thrust_shadow ~~~ facing ^^^1000",
            "/particle new:baelroth_slash",
            "/playsound items.baelroth_slash3 @a[r=30] ~~~ 0.4 1.8",
            "/tag @s add br3",
            "/execute at @e[family=!damage,family=!can_ride,type=!custom:vanish,tag=!br2,c=5,r=5] run particle new:baelroth_impact",
            "/damage @e[type=!custom:baelroth_thrust,r=5,type=!custom:vanish,tag=!br3] 5",
            "/tag @s remove br3"
          ],
          "on_exit": [
            "/scoreboard players set @s attack_delay 0"
          ],
          "transitions": [
            {
              "ns1": "variable.attack_time && query.scoreboard('attack_delay') >= 8 && !query.is_sneaking && q.get_equipped_item_name == 'baelroth'"
            }
          ]
        }
      }
    }
  }
}
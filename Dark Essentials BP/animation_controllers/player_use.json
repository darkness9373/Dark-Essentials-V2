{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.baelroth1": {
            "initial_state": "default",
            "states": {
                "default":{
                    "transitions": [
                        {"warrior_use1": "(query.get_equipped_item_name == 'baelroth') && (query.is_using_item) && (query.is_sneaking)"}
                    ]
                },
                "warrior_use1": {
                    "transitions": [
                        {"warrior_use11": "(query.get_equipped_item_name == 'baelroth') && query.scoreboard('baelroth1') <= 2 && query.scoreboard('baelroth1') >= 1"}
                    ],
                    "animations":[
                        "skill1"
                    ]
                },
                "warrior_use11": {
                    "transitions": [
                        {"default": "(query.get_equipped_item_name == 'baelroth')"}
                    ],
                    "on_entry":[
                        "/scoreboard players set @s baelroth1 0"
                    ]
                }
            }
        },

{
  "format_version": "1.11.0",
  "minecraft:entity": {
    "description": {
      "identifier": "custom:grayson_right_slash_big",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "despawn": {
        "minecraft:transformation": {
          "into": "custom:vanish",
          "drop_equipment": false,
          "delay": {
            "value": 0.6
          }
        }
			}
		},
    "components": {
      "minecraft:damage_sensor": [
        {
          "cause": "all",
          "deals_damage": false,
          "on_damage": {
            "filters": {
              "all_of": [
                { "test": "has_damage", "subject": "self", "operator": "not", "value": "fatal" }
              ]
            }
         }
        },
        {
          "cause": "all",
          "deals_damage": false,
          "on_damage": {
            "filters": {
              "any_of": [
                { "test": "has_damage", "operator": "==", "value": "fatal" }
              ]
            }
          }
        }
      ],
      "minecraft:scale": {
        "value": 3
      },
      "minecraft:timer": {
        "looping": false,
        "time": 0.1,
        "time_down_event": {
          "event": "despawn"
        }
      },
      "minecraft:despawn": {
				"remove_child_entities": true,
				"filters": {
					"all_of": [
						{
							"test": "is_family",
							"subject": "self",
							"value": "despawn"
						}
					]
				}
			},
      "minecraft:type_family": {
        "family": [ "damage" ]
      },
      "minecraft:collision_box": {
        "width": 0.05,
        "height": 0.05
      },
      "minecraft:health": {
        "value": 999,
        "max": 999
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:loot": {
        "table": ""
      },
      "minecraft:nameable": {
      },
      "minecraft:persistent": {
      },
	  "minecraft:physics": {
		"has_gravity": false
	  },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "run_command":{
          "command":[
            "tp @e[type=custom:grayson_right_slash,r=1,c=1] ~ ~ ~ facing ^ ^ ^1000"
          ]
        }
      },
      "despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      }
    }
  }
}
{
    "namespace": "preset",
    "label_collection": {
        "type": "panel",
        "$size|default": [100, 16],
        "$anchor|default": "center",
        "$offset|default": [0, 0],
        "$collection_index|default": 0,
        "$text_anchor|default": "left_middle",
        "$text_alignment|default": "center",
        "$font_scale|default": 1,
        "$font_type|default": "default",
        "$font_color|default": [1, 1, 1],
        "$font_offset|default": [0, 0],
        "$max_size|default": [100, 16],
        "size": "$size",
        "anchor_from": "$anchor",
        "anchor_to": "$anchor",
        "offset": "$offset",
        "controls": [
            {
                "stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", "100%"],
                    "collection_name": "form_buttons",
                    "controls": [
                        {
                            "pane": {
                                "type": "panel",
                                "size": ["100%", "100%"],
                                "collection_index": "$collection_index",
                                "bindings": [
                                    {
                                        "binding_type": "collection_details",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ],
                                "controls": [
                                    {
                                        "label": {
                                            "type": "label",
                                            "text": "#form_button_text",
                                            "anchor_from": "$text_anchor",
                                            "anchor_to": "$text_anchor",
                                            "text_alignment": "$text_alignment",
                                            "font_scale_factor": "$font_scale",
                                            "color": "$font_color",
                                            "font_type": "$font_type",
                                            "offset": "$font_offset",
                                            "max_size": "$max_size",
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "close_button": {
        "type": "button",
        "$size|default": [20, 20],
        "$anchor|default": "right_middle",
        "$offset|default": [-10, 0],
        "$layer|default": 4,
        "$tex_def|default": "textures/darkesse/shop/close_default",
        "$tex_hov|default": "textures/darkesse/shop/close_hover",
        "$tex_pre|default": "textures/darkesse/shop/close_default",
        "$tex_icon|default": "textures/darkesse/shop/close_x",
        "$icon_size|default": [14, 14],
        "size": "$size",
        "anchor_from": "$anchor",
        "anchor_to": "$anchor",
        "offset": "$offset",
        "layer": "$layer",
        "default_control": "def",
        "hover_control": "hov",
        "pressed_control": "pre",
        "controls": [
            {
                "def": {
                    "type": "panel",
                    "controls": [
                        {
                            "bg": {
                                "type": "image",
                                "size": ["100%", "100%"],
                                "texture": "$tex_def"
                            }
                        }
                    ]
                }
            },
            {
                "hov": {
                    "type": "panel",
                    "controls": [
                        {
                            "bg": {
                                "type": "image",
                                "size": ["100%", "100%"],
                                "texture": "$tex_hov"
                            }
                        }
                    ]
                }
            },
            {
                "pre": {
                    "type": "panel",
                    "controls": [
                        {
                            "bg": {
                                "type": "image",
                                "size": ["100%", "100%"],
                                "texture": "$tex_pre"
                            }
                        }
                    ]
                }
            },
            {
                "icon": {
                    "type": "image",
                    "texture": "$tex_icon",
                    "size": "$icon_size",
                    "layer": 5,
                    "anchor_from": "center",
                    "anchor_to": "center"
                }
            }
        ],
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "button.menu_exit",
                "mapping_type": "pressed"
            }
        ],
        "sound_name": "random.click",
        "sound_volume": 1,
        "sound_pitch": 1
    },
    "row_button": {
        "type": "panel",
        "$size|default": ["100% - 2px", 33],
        "$offset|default": [2, 0],
        "$marker|default": "§l§i§s§t§r",
        "$bg_def|default": "textures/darkesse/shop/list_bg_def",
        "$bg_hov|default": "textures/darkesse/shop/list_bg_hov",
        "$bg_pre|default": "textures/darkesse/shop/list_bg_def",
        "$row_h|default": 32,
        "$badge_size|default": [40, 18],
        "$badge_offset|default": [-4, 0],
        "$badge_def|default": "textures/darkesse/shop/list_btn_def",
        "$badge_hov|default": "textures/darkesse/shop/list_btn_hov",
        "$badge_pre|default": "textures/darkesse/shop/list_btn_def",
        "$badge_text|default": "BUY",
        "$badge_color|default": [0, 0, 0],
        "$icon_size|default": [28, 32],
        "$img_size|default": [20, 20],
        "$label_offset|default": [2, 0],
        "$font_scale|default": 1.0,
        "$font_color|default": [1, 1, 1],
        "$spacer|default": [48, 32],
        "size": "$size",
        "offset": "$offset",
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#form_button_text - '$marker') = #form_button_text))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "row_hit": {
                    "type": "button",
                    "size": ["100%", "$row_h"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "focus_enabled": false,
                    "default_control": "def",
                    "hover_control": "hov",
                    "pressed_control": "press",
                    "controls": [
                        {
                            "def": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$bg_def",
                                            "size": ["100%", "$row_h"],
                                            "anchor_from": "center",
                                            "anchor_to": "center"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "hov": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$bg_hov",
                                            "size": ["100%", "$row_h"],
                                            "anchor_from": "center",
                                            "anchor_to": "center"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "press": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$bg_pre",
                                            "size": ["100%", "$row_h"],
                                            "anchor_from": "center",
                                            "anchor_to": "center"
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "button_mappings": []
                }
            },
            {
                "content_stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": ["100%", "$row_h"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 2,
                    "controls": [
                        {
                            "icon_panel": {
                                "type": "panel",
                                "size": "$icon_size",
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_texture",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not (#form_button_texture = ''))",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "textures": {
                                            "type": "image",
                                            "size": "$img_size",
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_texture",
                                                    "binding_name_override": "#texture",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(('%.8s' * #texture) = 'textures')",
                                                    "target_property_name": "#visible"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "aux_item": {
                                            "type": "custom",
                                            "renderer": "inventory_item_renderer",
                                            "size": "$img_size",
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_texture",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(not ((#form_button_texture = '') or (('%.8s' * #form_button_texture) = 'textures')))",
                                                    "target_property_name": "#visible"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(#form_button_texture - '§a§u§x')",
                                                    "target_property_name": "#item_id_aux"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "label_wrap": {
                                "type": "panel",
                                "size": ["fill", "$row_h"],
                                "controls": [
                                    {
                                        "label": {
                                            "type": "label",
                                            "text": "#form_button_text",
                                            "anchor_from": "left_middle",
                                            "anchor_to": "left_middle",
                                            "offset": "$label_offset",
                                            "text_alignment": "left",
                                            "font_scale_factor": "$font_scale",
                                            "color": "$font_color",
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "buy_spacer": {
                                "type": "panel",
                                "size": "$spacer"
                            }
                        }
                    ]
                }
            },
            {
                "badge": {
                    "type": "button",
                    "size": "$badge_size",
                    "anchor_from": "right_middle",
                    "anchor_to": "right_middle",
                    "offset": "$badge_offset",
                    "layer": 3,
                    "$pressed_button_name": "button.form_button_click",
                    "default_control": "def",
                    "hover_control": "hov",
                    "pressed_control": "press",
                    "button_mappings": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "$pressed_button_name",
                            "mapping_type": "pressed"
                        },
                        {
                            "from_button_id": "button.menu_ok",
                            "to_button_id": "$pressed_button_name",
                            "mapping_type": "focused"
                        }
                    ],
                    "controls": [
                        {
                            "def": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$badge_def",
                                            "size": ["100%", "100%"],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "hov": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$badge_hov",
                                            "size": ["100%", "100%"],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "press": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "image": {
                                            "type": "image",
                                            "texture": "$badge_pre",
                                            "size": ["100%", "100%"],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_text",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "buy_label": {
                                "type": "label",
                                "text": "$badge_text",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "text_alignment": "center",
                                "font_scale_factor": 1.0,
                                "layer": 1,
                                "color": "$badge_color"
                            }
                        }
                    ],
                    "sound_name": "random.click",
                    "sound_volume": 1,
                    "sound_pitch": 1,
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "form_buttons"
                        }
                    ]
                }
            }
        ]
    }
}

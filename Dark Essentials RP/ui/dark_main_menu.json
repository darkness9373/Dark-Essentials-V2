    "menu_btn_row": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "$btn1|default": 5,
        "$label1|default": 6,
        "$btn2|default": 7,
        "$label2|default": 8,
        "$gap|default": [4, 40],
        "size": ["100%", 40],
        "collection_name": "form_buttons",
        "controls": [
            {
                "left_btn@dark_main.menu_btn": {
                    "collection_index": "$btn1",
                    "$label": "$label1"
                }
            },
            {
                "btn_gap": {
                    "type": "panel",
                    "size": "$gap"
                }
            },
            {
                "right_btn@dark_main.menu_btn": {
                    "collection_index": "$btn2",
                    "$label": "$label2"
                }
            }
        ]

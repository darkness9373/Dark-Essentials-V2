                        },
                        {
                            "prize_arrow": {
                                "type": "image",
                                "texture": "textures/darkesse/gacha_arrow",
                                "size": [21, 21],
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "offset": [0, -6],
                                "layer": 10
                            }
                        }
                    ]
                }
            },
            {
                "claim_wrap": {
                    "type": "stack_panel",
                    "size": [200, 32],
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "collection_name": "form_buttons",
                    "alpha": "@dark_gacha.claim_hide",
                    "propagate_alpha": true,
                    "offset": "@dark_gacha.claim_off_out",
                    "controls": [
                        {
                            "claim_btn@dark_gacha.claim_btn": {
                                "collection_index": 0
                            }
                        }
                    ]
                }
            }
        ]
    },
    "gacha_slot": {
        "type": "panel",
        "size": [64, 44],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ],
        "controls": [
            {
                "slot_icon": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "size": [28, 28],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "bindings": [
                        {
                            "binding_name": "#form_button_texture",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#form_button_texture = '') or (('%.8s' * #form_button_texture) = 'textures')))",
                            "target_property_name": "#visible"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#form_button_texture - '§a§u§x')",
                            "target_property_name": "#item_id_aux"
                        }
                    ]
                }
            },
            {
                "text": {
                    "type": "label",
                    "text": "#form_button_text",
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "font_scale_factor": 0.7,
                    "max_size": [62, 12],
                    "text_alignment": "center",
                    "color": [1, 1, 1],
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        }
                    ]
                }
            }
        ]
    },
    "claim_btn": {
        "type": "button",
        "size": [200, 32],
        "layer": 4,
        "focus_enabled": true,
        "$pressed_button_name": "button.form_button_click",
        "default_control": "def",
        "hover_control": "hov",
        "pressed_control": "press",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "def": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "layer": 1,
                                "texture": "textures/darkesse/button_default",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "hov": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "layer": 1,
                                "texture": "textures/darkesse/button_hover",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "press": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "layer": 1,
                                "texture": "textures/darkesse/button_default",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "label": {
                    "type": "label",
                    "layer": 2,
                    "text": "#form_button_text",
                    "font_scale_factor": 0.9,
                    "color": [1, 1, 1],
                    "text_alignment": "center",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        }
                    ]
                }
            }
        ],
        "sound_name": "random.click",
        "sound_volume": 1,
        "sound_pitch": 1,
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ]
    },
    "spin_anim": {
        "anim_type": "offset",
        "easing": "out_circ",
        "from": [0, 0],
        "to": [-2220, 0],
        "duration": 9
    },
    "claim_hide": {
        "anim_type": "alpha",
        "easing": "linear",
        "duration": 0,
        "from": 1,
        "to": 0,
        "next": "@dark_gacha.claim_wait"
    },
    "claim_wait": {
        "anim_type": "wait",
        "duration": 10,
        "next": "@dark_gacha.claim_show"
    },
    "claim_show": {
        "anim_type": "alpha",
        "easing": "in_sine",
        "from": 0,
        "to": 1,
        "duration": 0.7
    },
    "claim_off_out": {
        "anim_type": "offset",
        "easing": "linear",
        "duration": 0,
        "from": [0, 0],
        "to": [0, 1000],
        "next": "@dark_gacha.claim_off_wait"
    },
    "claim_off_wait": {
        "anim_type": "wait",
        "duration": 9,
        "next": "@dark_gacha.claim_off_in"
    },
    "claim_off_in": {
        "anim_type": "offset",
        "easing": "linear",
        "duration": 0,
        "from": [0, 1000],
        "to": [0, -10]
    }
}

        "controls": [
            {
                "bg": {
                    "type": "image",
                    "texture": "textures/darkesse/background",
                    "size": ["100%", "100%"]
                }
            },
            {
                "title": {
                    "type": "label",
                    "text": "#title_text",
                    "text_alignment": "center",
                    "font_scale_factor": 1.5,
                    "font_type": "MinecraftTen",
                    "offset": [0, 8],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        }
                    ]
                }
            },
            {
                "hint": {
                    "type": "label",
                    "text": "Good luck!",
                    "text_alignment": "center",
                    "font_scale_factor": 0.9,

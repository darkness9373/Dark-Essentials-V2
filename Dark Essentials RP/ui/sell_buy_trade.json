{
    "namespace": "buy_sell",
    "buysell_root": {
        "type": "panel",
        "bindings": [
            {
                "binding_name": "#title_text"
            }
        ],
        "controls": [
            {
                "overlay": {
                    "type": "image",
                    "size": [10000, 10000],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "texture": "textures/ui/Black",
                    "alpha": 0.4
                }
            },
            {
                "bs_body@buy_sell.bs_body": {}
            }
        ]
    },
    "bs_body": {
        "type": "panel",
        "size": [220, 260],
        "anchor_from": "center",
        "anchor_to": "center",
        "controls": [
            {
                "bg": {
                    "type": "image",
                    "size": ["100%", "100%"],
                    "texture": "textures/darkesse/shop/header",
                    "anchor_from": "center",
                    "anchor_to": "center"
                }
            },
            {
                "title": {
                    "type": "label",
                    "text": "#title_text",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, 6],
                    "text_alignment": "center",
                    "font_type": "MinecraftTen",
                    "color": "black",
                    "font_scale_factor": 1.5,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        }
                    ]
                }
            },
            {
                "close": {
                    "type": "button",
                    "size": [16, 16],
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "offset": [-5, 5],
                    "layer": 4,
                    "default_control": "def",
                    "hover_control": "hov",
                    "pressed_control": "pre",
                    "controls": [
                        {
                            "def": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "bg": {
                                            "type": "image",
                                            "size": [16, 16],
                                            "texture": "textures/darkesse/shop/close_default"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "hov": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "bg": {
                                            "type": "image",
                                            "size": [16, 16],
                                            "texture": "textures/darkesse/shop/close_hover"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "pre": {
                                "type": "panel",
                                "controls": [
                                    {
                                        "bg": {
                                            "type": "image",
                                            "size": [16, 16],
                                            "texture": "textures/darkesse/shop/close_default"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "icon": {
                                "type": "image",
                                "texture": "textures/darkesse/shop/close_x",
                                "size": [10, 10],
                                "layer": 5,
                                "anchor_from": "center",
                                "anchor_to": "center"
                            }
                        }
                    ],
                    "button_mappings": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "button.menu_exit",
                            "mapping_type": "pressed"
                        }
                    ],
                    "sound_name": "random.click",
                    "sound_volume": 1,
                    "sound_pitch": 1
                }
            },
            {
                "preview_wrap": {
                    "type": "panel",
                    "size": [64, 56],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, 30],
                    "controls": [
                        {
                            "preview_stack@buy_sell.bs_preview_stack": {}
                        }
                    ]
                }
            },
            {
                "detail": {
                    "type": "panel",
                    "size": [190, 110],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [0, 92],
                    "controls": [
                        {
                            "detail_bg": {
                                "type": "image",
                                "texture": "textures/darkesse/shop/money_bg",
                                "size": ["100%", "100%"],
                                "anchor_from": "center",
                                "anchor_to": "center"
                            }
                        },
                        {
                            "detail_label": {
                                "type": "label",
                                "text": "#form_text",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [6, 5],
                                "layer": 100,
                                "text_alignment": "left",
                                "font_scale_factor": 1,
                                "color": [0, 0, 0]
                            }
                        }
                    ]
                }
            },
            {
                "btn_row@buy_sell.bs_btn_row": {}
            }
        ]
    },
    "bs_preview_stack": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [48, 48],
        "anchor_from": "center",
        "anchor_to": "center",
        "collection_name": "form_buttons",
        "controls": [
            {
                "preview_slot@buy_sell.bs_preview_slot": {
                    "collection_index": 0
                }
            }
        ]
    },
    "bs_preview_slot": {
        "type": "panel",
        "size": [48, 48],
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_name": "#form_button_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not (#form_button_text = ''))",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "textures": {
                    "type": "image",
                    "size": [40, 40],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_name_override": "#texture",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(('%.8s' * #texture) = 'textures')",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "aux_item": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "size": [40, 40],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#form_button_text = '') or (('%.8s' * #form_button_text) = 'textures')))",
                            "target_property_name": "#visible"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(#form_button_text - '§a§u§x')",
                            "target_property_name": "#item_id_aux"
                        }
                    ]
                }
            }
        ]
    },
    "bs_btn_row": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": [190, 26],
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "offset": [0, -8],
        "collection_name": "form_buttons",
        "controls": [
            {
                "act_btn@buy_sell.bs_btn": {
                    "collection_index": 1
                }
            },
            {
                "btn_gap": {
                    "type": "panel",
                    "size": [10, 26]
                }
            },
            {
                "cancel_btn@buy_sell.bs_btn": {
                    "collection_index": 2
                }
            }
        ]
    },
    "bs_btn": {
        "type": "button",
        "size": [90, 24],
        "$pressed_button_name": "button.form_button_click",
        "default_control": "def",
        "hover_control": "hov",
        "pressed_control": "press",
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$pressed_button_name",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "def": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "texture": "textures/darkesse/shop/list_btn_def",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "hov": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "texture": "textures/darkesse/shop/list_btn_hov",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "press": {
                    "type": "panel",
                    "controls": [
                        {
                            "image": {
                                "type": "image",
                                "texture": "textures/darkesse/shop/list_btn_def",
                                "size": ["100%", "100%"]
                            }
                        }
                    ]
                }
            },
            {
                "label": {
                    "type": "label",
                    "text": "#form_button_text",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "text_alignment": "center",
                    "font_scale_factor": 1,
                    "layer": 1,
                    "color": [0, 0, 0],
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        }
                    ]
                }
            }
        ],
        "sound_name": "random.click",
        "sound_volume": 1,
        "sound_pitch": 1,
        "bindings": [
            {
                "binding_type": "collection_details",
                "binding_collection_name": "form_buttons"
            }
        ]
    }
}

{
    "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
    "namespace": "server_form",
    "long_form": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_name": "#title_text"
                    },
                    {
                        "binding_type": "view",
                        "source_property_name": "((#title_text - '§d§e§s§r') = #title_text)",
                        "target_property_name": "#visible"
                    }
                ]
            }
        ]
    },
    "custom_form": {
        "modifications": [
            {
                "array_name": "bindings",
                "operation": "insert_back",
                "value": [
                    {
                        "binding_name": "#title_text"
                    },
                    {
                        "binding_type": "view",
                        "source_property_name": "((#title_text - '§d§e§s§r') = #title_text)",
                        "target_property_name": "#visible"
                    }
                ]
            }
        ]
    },
    "dark_custom_form_panel": {
        "type": "panel",
        "bindings": [
            {
                "binding_name": "#title_text"
            }
        ],
        "controls": [
            {
                "dark_modal@dark_ess.modal_base": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_custom_form_panel",
                            "source_property_name": "(not ((#title_text - '§d§e§s§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "dark_long_form_panel": {
        "type": "panel",
        "bindings": [
            {
                "binding_name": "#title_text"
            }
        ],
        "controls": [
            {
                "dark_form@dark_ess.base": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§d§e§s§r') = #title_text)) and ((#title_text - '§g§a§c§h§r') = #title_text) and ((#title_text - '§s§h§o§p§r') = #title_text) and ((#title_text - '§c§o§n§f§r') = #title_text) and ((#title_text - '§m§a§i§n§r') = #title_text) and ((#title_text - '§t§r§a§d§r') = #title_text) and ((#title_text - '§b§n§s§r') = #title_text) and ((#title_text - '§p§v§p§r') = #title_text)",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_gacha@dark_gacha.spin_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§g§a§c§h§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_shop@dark_shop.shop_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§s§h§o§p§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_conf@dark_conf.conf_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§c§o§n§f§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_main@dark_main.main_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§m§a§i§n§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_trade@dark_trade.trade_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§t§r§a§d§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "buy_sell@buy_sell.buysell_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§b§n§s§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "dark_pvp@dark_pvp.pvp_root": {
                    "bindings": [
                        {
                            "binding_type": "view",
                            "source_control_name": "dark_long_form_panel",
                            "source_property_name": "(not ((#title_text - '§p§v§p§r') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    },
    "main_screen_content": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "dark_server_form_factory": {
                            "type": "panel",
                            "factory": {
                                "name": "server_form_factory",
                                "control_ids": {
                                    "long_form": "@server_form.dark_long_form_panel",
                                    "custom_form": "@server_form.dark_custom_form_panel"
                                }
                            }
                        }
                    }
                ]
            }
        ]
    }
}

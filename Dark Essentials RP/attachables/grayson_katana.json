{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "custom:grayson",
      "materials": {
        "default": "enderman",
        "enchanted": "enderman"
      },
			"textures": {
				"default": "textures/entity/grayson_katana/grayson_katana",
				"enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
				"default": "geometry.grayson_katana",
				"on_back": "geometry.grayson_back"
			},
			"animations": {
				"wield_first_person": "animation.katana.fpp",
				"wield_third_person": "animation.katana.tpp"
			},
			"scripts": {
				"animate": [
					{
						"wield_first_person": "c.is_first_person"
					},
					{
						"wield_third_person": "!c.is_first_person"
					}
				]
			},
			"render_controllers": [
					{"controller.render.default" : "q.is_item_name_any('slot.weapon.mainhand', 0, 'custom:grayson')"},
				{"controller.render.on_back" : "q.is_item_name_any('slot.weapon.offhand', 0, 'custom:grayson')"}
			]
		}
	}
}